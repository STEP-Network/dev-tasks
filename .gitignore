node_modules/

# build output
# Note: plugin/dist/ IS committed — Claude Code marketplace installs do not
# run the `prepare`/`build` script, so consumers need pre-built artifacts in
# the repo. Regenerate via `npm run build` before commit when src/ changes.
*.tsbuildinfo

# env files
.env
.env.*
!.env.example

# misc
.DS_Store

# Claude Code per-user / per-session state
