{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_monday_com__.*|mcp__claude_ai_Slack__.*|mcp__linear-server__.*|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/people-doors-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rule-autoload.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/task-state-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-required.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-path-boundary.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-active-task-state.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/branch-task-match.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dev-tasks_dev-tasks__updateTask",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dev-tasks-update-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/demo-url-required.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/staging-deploy-ready-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dev-tasks_dev-tasks__claimTask",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/refinement-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.env*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/.env*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Edit(**/.mcp.json)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/.mcp.json)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Edit(**/secrets/**)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/secrets/**)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Edit(**/credentials/**)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/credentials/**)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Edit(**/pnpm-lock.yaml)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/pnpm-lock.yaml)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Edit(**/package-lock.json)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          },
          {
            "type": "command",
            "if": "Write(**/package-lock.json)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(* --no-verify *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(*--force*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(rm -rf *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git reset --hard *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git checkout .)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git checkout -- *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git clean -f*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git branch -D*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-merge-policy-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-merge-review-gate.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-secrets-scan.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/commit-id-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-push-track.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-push-review-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-merge-postmortem.sh"
          },
          {
            "type": "command",
            "if": "Bash(*claude-ci-ack-*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-file-followup-nudge.sh"
          },
          {
            "type": "command",
            "if": "Bash(*gh run rerun *--failed*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-file-followup-nudge.sh"
          },
          {
            "type": "command",
            "if": "Bash(git revert *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/auto-file-followup-nudge.sh"
          },
          {
            "type": "command",
            "if": "Bash(pnpm *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/build-failure-advisor.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pipeline-reminder.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ui-change-test-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-ci-green-check.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-waiting-for-uat-stage.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-monday-reconciled-check.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-visual-diff-check.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-goal-persistence.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact-task-snapshot.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-task-context.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subprocess-failure.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-janitor.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/active-task-recon.sh"
          }
        ]
      }
    ]
  }
}
