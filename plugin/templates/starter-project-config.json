{
  "$schema": "https://raw.githubusercontent.com/STEP-Network/dev-tasks/main/plugin/schemas/project-config.schema.json",
  "version": "1",
  "git": {
    "defaultBase": "main",
    "hotfixBase": "main",
    "branchConvention": "feat/<slug>",
    "autoMergePolicy": {
      "main": "never"
    },
    "protectedBranches": ["main", "staging", "master", "production", "prod"]
  },
  "monday": {
    "productId": "REQUIRED — Monday Products-board item ID for this product",
    "v1MilestoneEpicIds": []
  },
  "environments": {
    "uat": { "url": "https://test.example.com" }
  },
  "i18n": {
    "enabled": false
  },
  "ci": {
    "requiredChecks": ["build", "test", "lint"],
    "previewUrlPattern": "^https://",
    "autoSkip": {
      "enabled": false,
      "maxChangedLines": 50,
      "pathAllowlist": [],
      "pathDenylist": ["migrations/**", "**/migrations/**", "db/**", "**/db/**", "auth/**", "**/auth/**", "api/**", "**/api/**", "*.sql"]
    }
  },
  "rules": {
    "extraRules": []
  },
  "review": {
    "sources": ["claudeBot", "corridor", "selfReview", "localReview"],
    "cloudBot": "always"
  },
  "hooks": {
    "enabled": [
      "task-state-guard",
      "worktree-required",
      "worktree-path-boundary",
      "branch-task-match",
      "stop-task-check",
      "protect-sensitive-files",
      "pre-commit-secrets-scan",
      "subtask-reminder",
      "auto-file-followup-nudge",
      "post-merge-postmortem",
      "post-push-track",
      "post-push-review-check",
      "post-self-review",
      "pre-compact-task-snapshot",
      "user-prompt-task-context",
      "subprocess-failure",
      "refinement-gate",
      "subtask-progress-gate",
      "demo-url-required",
      "stop-waiting-for-uat-stage",
      "stop-monday-reconciled-check",
      "protect-active-task-state",
      "stop-goal-persistence",
      "auto-merge-policy-gate"
    ]
  },
  "e2e": {
    "enabled": false,
    "framework": "playwright",
    "specDir": "e2e",
    "baselineSnapshots": "commit",
    "baseUrl": {
      "preview": "auto",
      "local": "http://localhost:3000"
    },
    "personas": [
      {
        "id": "public-visitor",
        "storageState": null,
        "description": "Unauthenticated visitor — public marketing pages, signup flows."
      }
    ],
    "humanOnlyChecks": [
      "Subjective design quality (visual hierarchy, brand voice)",
      "Copy tone — does the copy match brand voice / locale conventions",
      "Business logic correctness on novel edge cases not covered by AC",
      "Cross-browser parity beyond Playwright's default Chromium (Safari, Firefox)"
    ],
    "flakyDir": "e2e/flaky",
    "fullSuite": {
      "enabled": true,
      "target": "staging",
      "workers": "50%",
      "recordTo": ["uatDoc", "mondayUpdate"],
      "onRed": "record"
    }
  },
  "visualDiff": {
    "enabled": true,
    "viewports": ["desktop", "mobile"],
    "maxRoutes": 8,
    "authPersona": null,
    "routeMap": []
  }
}
