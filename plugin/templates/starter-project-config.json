{
  "$schema": "../../dev-tasks-mcp/plugin/schemas/project-config.schema.json",
  "version": "1",
  "git": {
    "defaultBase": "main",
    "hotfixBase": "main",
    "branchConvention": "feat/<slug>",
    "worktreeRoot": ".claude/worktrees",
    "autoMergePolicy": {
      "main": "never"
    }
  },
  "i18n": {
    "enabled": false
  },
  "ci": {
    "provider": "github-actions",
    "requiredChecks": ["build", "test", "lint"]
  },
  "rules": {
    "extraRules": []
  },
  "hooks": {
    "enabled": [
      "task-state-guard",
      "worktree-required",
      "worktree-path-boundary",
      "branch-task-match",
      "bash-guard",
      "stop-task-check",
      "stop-ci-green-check"
    ]
  }
}
