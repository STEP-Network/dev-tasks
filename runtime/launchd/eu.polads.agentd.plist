<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>eu.polads.agentd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--import</string>
    <string>tsx</string>
    <string>__RUNTIME__/src/agentd/main.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUNTIME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>AGENTD_HOME</key>
    <string>__AGENTD_HOME__</string>
    <key>DISABLE_AUTOUPDATER</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__AGENTD_HOME__/logs/agentd.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__AGENTD_HOME__/logs/agentd.launchd.log</string>
</dict>
</plist>
