{
  "name": "dev-tasks-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "agentd, the Slack bridge and the SDK worker for dev-tasks agent minis (two-flow spec sections 6 and 8).",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:sh": "bash test/statusline.test.sh && bash test/install.test.sh && bash test/bootstrap.test.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "chrome-devtools-mcp": "1.9.0",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
