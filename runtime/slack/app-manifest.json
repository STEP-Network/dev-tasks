{
  "display_information": {
    "name": "PolAds {{Mini}}",
    "description": "A PolAds agent mini. Files intake, asks questions, reports work.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": { "display_name": "{{mini}}", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "reactions:read",
        "reactions:write",
        "users:read",
        "files:read",
        "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups", "reaction_added"] },
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
